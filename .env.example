PORT=3001
BASE_URL=http://localhost:3001

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_key

# Gemini API (for scraping)
GEMINI_API_KEY=your_gemini_key

# Anthropic / Claude API (for HTML generation)
ANTHROPIC_API_KEY=your_anthropic_key

# Resend (for email outreach)
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Vercel (auto-deploy previews)
VERCEL_TOKEN=vck_...

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_AMOUNT=29900

# Optional. Page where the Google Maps sites' "Activar mi web" button and the Resend emails send people to book a call
# (any booking page URL). Without it those buttons are simply left out. The new-LLC campaign does not use it.
CALENDAR_URL=

# Telegram alerts on your phone (a lead asked for a call / replied to the email). Create a bot with @BotFather, send it any
# message, then run `npm run telegram:setup` to get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# App settings
PREVIEW_EXPIRY_DAYS=15

# ─── New-business leads campaign (Connecticut LLCs) ───────────────────────────
# Test mode: the push to Instantly and the Telegram alerts are written to the log instead of being sent
OUTREACH_DRY_RUN=true
# UUID of your Supabase user (Supabase → Authentication → Users → copy the "User UID"). Every new lead row carries it.
NEW_LEADS_OWNER_USER_ID=
# Optional: free app token from data.ct.gov (avoids request throttling): https://data.ct.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# Optional: API key of a paid email verifier (hook prepared in src/services/emailVerify.js, no provider wired yet)
EMAIL_VERIFIER_API_KEY=

# Emails are sent by Instantly (its own Google Workspace mailboxes, warm-up, schedule and unsubscribe link). What happens
# to each lead (sent, bounced, unsubscribed, replied) is found by asking Instantly's API every 5 minutes, not a webhook
# (those need Instantly's paid Hypergrowth plan; the API works on every plan, including the free trial).
# API v2 key: Instantly → Settings → Integrations → API keys (needs the "leads" scope)
INSTANTLY_API_KEY=
# UUID of the Instantly campaign that holds the email (print the text to paste with: npm run leads:email-template)
INSTANTLY_CAMPAIGN_ID=
# Public https URL of the campaign server (src/campaign-server.js on Render). The links inside the emails point there.
CAMPAIGN_PUBLIC_URL=
