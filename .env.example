PORT=3001
BASE_URL=http://localhost:3001

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_key

# Gemini API (for scraping)
GEMINI_API_KEY=your_gemini_key

# Anthropic / Claude API (for HTML generation)
ANTHROPIC_API_KEY=your_anthropic_key

# Resend (for email outreach)
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Vercel (auto-deploy previews)
VERCEL_TOKEN=vck_...

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_AMOUNT=29900

# App settings
PREVIEW_EXPIRY_DAYS=15

# ─── New-business leads campaign (Connecticut LLCs) ───────────────────────────
# Test mode: emails and Telegram alerts are written to the log instead of being sent
OUTREACH_DRY_RUN=true
# In dry-run the demo page is a stub (no Claude / Vercel calls). Set to true to build real demos while testing
DRY_RUN_REAL_DEMO=false
# ── Cold email sending (SMTP mailboxes: Google Workspace on secondary domains). Resend is NOT used for this flow. ──
# JSON on ONE line. With Google Workspace: host smtp.gmail.com, port 465, and an "app password" as pass.
# COLD_MAILBOXES=[{"id":"jose1","host":"smtp.gmail.com","port":465,"user":"jose@dominio1.com","pass":"app-password","from":"Jose <jose@dominio1.com>","dailyLimit":30}]
COLD_MAILBOXES=
# Daily limit for mailboxes that don't set their own "dailyLimit" (start low on new domains: 5-10/day, then raise)
COLD_DAILY_LIMIT=30
# Random pause between two emails of the same mailbox, in seconds
COLD_PAUSE_MIN_SEC=45
COLD_PAUSE_MAX_SEC=150
# Shown in every email footer (CAN-SPAM: name + real postal address). Real sends are refused without them.
COMPANY_NAME=
COMPANY_ADDRESS=
# Name that signs the emails
OUTREACH_SENDER_NAME=Jose
# BASE_URL (above) must be the PUBLIC https URL of the campaign server for real sends: the form and unsubscribe links point there.
# UUID of your Supabase user (Supabase → Authentication → Users → copy the "User UID"). Every new lead row carries it.
NEW_LEADS_OWNER_USER_ID=
# Optional: free app token from data.ct.gov (avoids request throttling): https://data.ct.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# Optional: API key of a paid email verifier (hook prepared in src/services/emailVerify.js, no provider wired yet)
EMAIL_VERIFIER_API_KEY=
