PORT=3001
BASE_URL=http://localhost:3001

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_key

# Gemini API (for scraping)
GEMINI_API_KEY=your_gemini_key

# Anthropic / Claude API (for HTML generation)
ANTHROPIC_API_KEY=your_anthropic_key

# Resend (for email outreach)
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Vercel (auto-deploy previews)
VERCEL_TOKEN=vck_...

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_AMOUNT=29900

# Booking page of the 15-minute call (a Calendly event URL). The outreach emails and the generated sites' "Activar mi web"
# button link to it; without it those buttons are simply left out.
CALENDAR_URL=
# Calendly personal access token (Calendly > Integraciones > API y webhooks). It lets the app see who booked a call, because
# clicking the link is not booking. It works on Calendly's free plan (no webhooks there): bookings are checked every 5 minutes.
CALENDLY_API_TOKEN=

# App settings
PREVIEW_EXPIRY_DAYS=15

# ─── New-business leads campaign (Connecticut LLCs) ───────────────────────────
# Test mode: the push to Instantly and the Telegram alerts are written to the log instead of being sent
OUTREACH_DRY_RUN=true
# UUID of your Supabase user (Supabase → Authentication → Users → copy the "User UID"). Every new lead row carries it.
NEW_LEADS_OWNER_USER_ID=
# Optional: free app token from data.ct.gov (avoids request throttling): https://data.ct.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# Optional: API key of a paid email verifier (hook prepared in src/services/emailVerify.js, no provider wired yet)
EMAIL_VERIFIER_API_KEY=

# Emails are sent by Instantly (its own Google Workspace mailboxes, warm-up, schedule and unsubscribe link).
# API v2 key: Instantly → Settings → Integrations → API keys (needs the leads and webhooks scopes)
INSTANTLY_API_KEY=
# UUID of the Instantly campaign that holds the email (print the text to paste with: npm run leads:email-template)
INSTANTLY_CAMPAIGN_ID=
# Any long random string. Instantly sends it in the x-webhook-secret header so only Instantly can call our webhook
INSTANTLY_WEBHOOK_SECRET=
# Public https URL of the campaign server (src/campaign-server.js on Render). The links inside the emails point there.
CAMPAIGN_PUBLIC_URL=
